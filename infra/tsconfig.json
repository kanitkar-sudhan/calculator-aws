{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "declaration": true,
    "inlineSourceMap": true,
    "experimentalDecorators": true,
    "skipLibCheck": true
  },
  "include": ["bin", "lib"],
  "exclude": ["node_modules", "cdk.out"]
}
